# Copy to .env for local dev. On Render/Railway, set these as environment variables instead.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=portfolio
# Long random string. Needed to POST new changelog entries. Never commit the real one.
ADMIN_KEY=change-me-to-something-long-and-random
# Your site's origin(s), comma-separated. Leave empty in dev to allow all.
CLIENT_ORIGIN=https://<your-username>.github.io
PORT=4000
